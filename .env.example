# ─────────────────────────────────────────────────────────────────────────────
# EventDrivenStore — Environment Variables
# Copy this file to .env and fill in the values before starting the services.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ── API Service ──────────────────────────────────────────────────────────────
PORT=3000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local Docker: mongodb://mongo:27017/eventstore
# Atlas:        mongodb+srv://<user>:<password>@cluster.mongodb.net/eventstore
MONGO_URI=mongodb://mongo:27017/eventstore

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# Format: amqp://<user>:<password>@<host>:<port>
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Exchange & queue names
RABBITMQ_EXCHANGE=store.events
RABBITMQ_QUEUE_ORDERS=orders
RABBITMQ_QUEUE_INVENTORY=inventory
RABBITMQ_QUEUE_NOTIFICATIONS=notifications

# Dead-letter exchange name
RABBITMQ_DLX=store.dlx

# ── Security (Phase 5) ───────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_before_production
JWT_EXPIRES_IN=7d

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
